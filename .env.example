# Optional Docker Compose overrides: copy this file to .env.
# Run `mkdir -p data/guest` before first startup so the host user owns the directory.
REDACTED_PORT=3001
# Optional separate data folder for testing a new realm (create it first).
# REDACTED_DATA_DIR=./data/onboarding-demo
# Set before creating a realm; its public address is bound to its configuration.
TIDECLOAK_PORT=8080
# For an existing TideCloak on the host, instead of the optional Compose service:
# TIDECLOAK_INTERNAL_URL=http://host.docker.internal:8080
# Match `id -u` and `id -g` on Linux when different from these defaults.
LOCAL_UID=1000
LOCAL_GID=1000

# Direct Python setup: export these in the shell; Python does not load this file.
# OPF_DEVICE=cpu
# PRIVACY_DATA_DIR=./data
# PRIVACY_FRONTEND_DIR=./dist
# Downloader destination (defaults to models/privacy-filter in this checkout):
# PRIVACY_MODEL_DIR=/absolute/path/to/models/privacy-filter
# OPF_CHECKPOINT=/absolute/path/to/models/privacy-filter/original
# TIKTOKEN_CACHE_DIR=/absolute/path/to/models/privacy-filter/tiktoken
# Enable only after downloading/validating model assets:
# HF_HUB_OFFLINE=1
# Development only: exact origin for the separate Vite hot-reload server.
# PRIVACY_DEV_ORIGIN=http://127.0.0.1:5173
